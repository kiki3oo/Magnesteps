# Copy these into Easypanel > Environment (never commit real values)
ADMIN_PASSWORD=change-me-long-password
SANADOKOM_WEBHOOK_SECRET=paste-the-NEW-secret-from-Sanadokom
SANADOKOM_WEBHOOK_URL=https://app.rovanx.com/api/webhooks/orders
DATA_DIR=/app/data
PORT=5500

# Anti-fake orders (optional, defaults shown)
MAX_ORDERS_PER_DEVICE_24H=2
MAX_ORDERS_PER_PHONE_24H=1
MAX_ORDERS_PER_IP_24H=10
# Number of trusted proxies in front of the app (1 = Easypanel/Traefik, 2 = Cloudflare + Traefik)
TRUSTED_PROXY_HOPS=1
